{
    "name": "eduardoaf/monorepo",
    "type": "project",
    "description": "Monorepo for EduardoAf packages: helpers and components.",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Acevedo Farje",
            "email": "eacevedof@gmail.com",
            "homepage": "https://eduardoaf.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "EduardoAf\\Helpers\\": "packages/helpers/src/",
            "EduardoAf\\Components\\": "packages/components/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduardoAf\\Helpers\\Tests\\": "packages/helpers/tests/",
            "EduardoAf\\Components\\Tests\\": "packages/components/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
